graph TD
    subgraph User Interfaces
        CLI["<b>CLI</b><br>(src/MassFlow/cli.py)"]
        API["<b>Python API</b>"]
        TUI["<b>Terminal UI Browser</b><br>(src/MassFlow/tui.py)"]
    end

    subgraph Orchestration
        Workflow["<b>Workflow Orchestrator</b><br>(src/MassFlow/workflow.py)"]
        Config["<b>Configuration Manager</b><br>(src/MassFlow/config.py)<br><i>Pydantic</i>"]
    end

    subgraph Data Ingestion & Storage
        IO["<b>I/O Layer</b><br>(src/MassFlow/io.py)"]
        DB["<b>Spectral Database</b><br>(src/MassFlow/database.py)<br><i>SQLite</i>"]
    end

    subgraph Data Processing & Filtering
        Process["<b>Processing Facade</b><br>(src/MassFlow/processing.py)<br><i>matchms Native Filters</i>"]
    end

    subgraph Similarity Engine
        Sim["<b>Similarity Engine</b><br>(src/MassFlow/similarity.py)<br><i>Strategy & Consensus Pattern</i>"]
        Algorithms["CosineGreedy<br>ModifiedCosine<br>Spec2Vec<br>MS2DeepScore<br>ConsensusEngine<br>CascadeEngine"]
    end

    subgraph Optional Utilities
        Networking["<b>GraphML Export</b><br>(src/MassFlow/networking.py)<br><i>NetworkX</i>"]
    end

    %% Flow Connections

    %% User Interface to Orchestration
    CLI -- "Run Workflow (annotate)" --> Workflow
    CLI -- "Browse Library" --> TUI
    API -- "Integrate into Script" --> Workflow

    %% Workflow Orchestration
    Workflow -- "Loads/Saves Config" --> Config
    Config -- "Provides Settings" --> Workflow

    Workflow -- "Reads Spectral Data" --> IO
    IO -- "Reads mzML/MGF/etc." --> Workflow
    IO -- "Writes Output Files" --> Workflow

    Workflow -- "Applies Filters" --> Process
    Process -- "Processed Spectra (matchms.Spectrum)" --> Workflow

    Workflow -- "Calculates Similarities" --> Sim
    Sim -- "Similarity Scores" --> Workflow
    Sim -- "Uses" --> Algorithms

    %% Data Storage and Retrieval
    IO -- "Loads/Saves Spectra" <--> DB
    DB -- "Stores Libraries" --> IO

    %% TUI interactions
    TUI -- "Queries/Displays Data" --> IO

    %% Optional Features
    Workflow -- "Exports Network" --> Networking
    Networking -- "GraphML File" --> CLI


    %% Data Flow Labels (more specific)
    IO -- "Raw Spectra" --> Workflow
    Process -- "Cleaned Spectra" --> Sim
    Sim -- "Annotation Results" --> Workflow
    Workflow -- "Structured Outputs" --> IO
