{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "dataset_id",
    "protocol_sha256",
    "identity_policy_sha256",
    "split_policy_sha256",
    "harness_commit",
    "assets",
    "record_ledger",
    "notes"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "draft",
        "frozen"
      ]
    },
    "dataset_id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "identity_policy_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "split_policy_sha256": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "harness_commit": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{40}$"
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_id",
          "kind",
          "url",
          "version",
          "sha256",
          "bytes",
          "local_path",
          "license_evidence_url",
          "redistribution"
        ],
        "properties": {
          "asset_id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "derivative",
              "labels",
              "structures",
              "acquisitions",
              "duplicates",
              "selection",
              "licenses",
              "conversions"
            ]
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          },
          "local_path": {
            "type": "string",
            "minLength": 1
          },
          "license_evidence_url": {
            "type": [
              "string",
              "null"
            ],
            "format": "uri"
          },
          "redistribution": {
            "enum": [
              "allowed",
              "restricted",
              "unresolved"
            ]
          }
        }
      }
    },
    "record_ledger": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "path",
            "sha256",
            "record_count"
          ],
          "properties": {
            "path": {
              "type": "string",
              "minLength": 1
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "record_count": {
              "type": "integer",
              "minimum": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MassFlow proposed scientific dataset freeze v1",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "frozen"
          }
        }
      },
      "then": {
        "properties": {
          "protocol_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "identity_policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "split_policy_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "harness_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "assets": {
            "minItems": 1
          },
          "record_ledger": {
            "type": "object"
          }
        }
      }
    }
  ]
}
